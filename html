<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>CyberSnake // Node_OS</title>
    <style>
        body {
            background: #0a0a12;
            color: #00ffcc;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        #score-board {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 15px;
            text-shadow: 0 0 10px #00ffcc;
        }
        canvas {
            border: 3px solid #ff0055;
            box-shadow: 0 0 30px #ff0055, inset 0 0 15px #ff0055;
            background-color: #05050a;
        }
        .instructions {
            margin-top: 15px;
            color: #888899;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div id="score-board">SYSTEM_SCORE: <span id="score">000</span></div>
    <canvas id="game" width="600" height="500"></canvas>
    <div class="instructions">> USE ARROW KEYS OR WASD TO JACK INTO THE NETWORK</div>
    <script src="game.js"></script>
</body>
</html>
